DATABASE_URL=postgresql+psycopg://crvt:change-me@db:5432/crvt
OPS_TOKEN=replace-with-a-long-random-demo-token
ALLOW_INSECURE_DEMO_CREDENTIALS=false
MAX_UPLOAD_BYTES=5242880
MAX_CSV_ROWS=100000
MAX_VALIDATION_ERRORS=50
MAX_HISTORY_RECORDS=10000
PASS_BRIER_MAX=0.20
WARNING_BRIER_MAX=0.25
PASS_CALIBRATION_GAP_MAX=0.05
WARNING_CALIBRATION_GAP_MAX=0.10
WARNING_DUPLICATE_RATE_MAX=0.01
LOG_LEVEL=INFO
LOG_FILE=/var/log/crvt/backend.jsonl
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
